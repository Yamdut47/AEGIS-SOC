<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Live Monitoring</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="monitoring">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>
    <div class="main-area">
      <div id="topbar-slot"></div>

      <div class="content">
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; align-items: center">
          <div style="display: flex; align-items: center; gap: 10px">
            <i class="fas fa-circle red" style="font-size: 8px"></i>
            <span style="font-size: 14px; font-weight: bold">Real-time Event Stream (Firebase)</span>
          </div>
          <button id="pause-btn" style="background: var(--red); color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px">
            Pause Stream
          </button>
        </div>
        <div class="console-log" id="live-console">
          <div class="log-line">
            <span style="color: var(--accent)">[SYS]</span>
            <span style="color: var(--green)">[INFO]</span> Connected to Firebase Realtime Database.
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/data.js"></script>
  <script src="js/app.js"></script>

  <script>
    window.addEventListener("aegis-ready", () => {
      const box = document.getElementById("live-console");
      const btn = document.getElementById("pause-btn");
      let paused = false, lineCount = 0;

      const LEVEL_COLOR = { INFO: "var(--green)", WARN: "var(--yellow)", ALERT: "var(--accent)", CRIT: "var(--red)" };

      function addLine(e) {
        if (paused || !e) return;
        const line = document.createElement("div");
        line.className = "log-line";
        line.innerHTML = `<span style="color: var(--accent)">[${fmtTime(e.ts)}]</span> <span style="color:${LEVEL_COLOR[e.level] || "var(--green)"}">[${e.level}]</span> ${esc(e.payload)} <span style="color: var(--text-dim)">${esc(e.src)} -> ${esc(e.dst)}:${e.port}</span>`;
        box.appendChild(line);
        lineCount++;
        while (lineCount > 150) { box.removeChild(box.firstChild); lineCount--; }
        box.scrollTop = box.scrollHeight;
      }

      // LIVE: show new events as they arrive in the database (any tab/user)
      db.ref("events").limitToLast(30).on("child_added", (snap) => addLine(snap.val()));

      // ---- Event generator (simulates Suricata feed -> writes to Firebase) ----
      const rand = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;
      const extIp = () => `${rand(1, 223)}.${rand(0, 255)}.${rand(0, 255)}.${rand(1, 254)}`;
      const intIp = () => `192.168.1.${rand(2, 254)}`;

      const TEMPLATES = [
        { level: "INFO",  proto: "TCP", port: 80,  payload: () => `HTTP ${rand(200, 418)} GET /app/api/v${rand(1, 3)}/status` },
        { level: "INFO",  proto: "UDP", port: 53,  payload: () => `DNS Query cdn.assets-${rand(1, 99)}.net` },
        { level: "INFO",  proto: "TCP", port: 443, payload: () => `TLS handshake OK cipher TLS_AES_256_GCM` },
        { level: "WARN",  proto: "TCP", port: 22,  payload: () => `SSH auth failure x${rand(3, 40)}` },
        { level: "WARN",  proto: "TCP", port: 0,   payload: () => `Port scan ports [${rand(20, 9000)},${rand(20, 9000)},${rand(20, 9000)}]` },
        { level: "ALERT", proto: "TCP", port: 0,   payload: () => `Suricata [SID ${rand(1000000, 9999999)}] ET SCAN Nmap` },
        { level: "CRIT",  proto: "TCP", port: 80,  payload: () => `SQLi pattern " OR 1=1--` },
        { level: "CRIT",  proto: "TCP", port: 443, payload: () => `C2 beacon interval ${rand(10, 120)}s` }
      ];

      function makeEvent() {
        const t = TEMPLATES[rand(0, TEMPLATES.length - 1)];
        return { ts: Date.now(), level: t.level, src: extIp(), dst: intIp(), proto: t.proto, port: t.port || rand(20, 9999), payload: t.payload() };
      }

      function tick() {
        if (paused) return;
        const e = makeEvent();
        db.ref("events").push(e);
        db.ref("stats/totalEvents").transaction((v) => (v || 0) + 1);

        // Critical events auto-create alerts (detection engine simulation)
        if (e.level === "CRIT" && Math.random() < 0.5) {
          const isSqli = e.payload.includes("SQLi");
          db.ref("stats/alertSeq").transaction((v) => (v || 1042) + 1, (err, committed, snap) => {
            if (!committed) return;
            db.ref("alerts").push({
              ts: Date.now(), seq: snap.val(), source: e.src,
              classification: isSqli ? "SQL Injection" : "Malware C2 Callback",
              risk: Number((rand(80, 99) + Math.random()).toFixed(1)),
              mitre: isSqli ? "T1190" : "T1071",
              status: "open",
              category: isSqli ? "SQL Injection" : "Malware"
            });
          });
        }
      }

      // Cleanup: remove events older than 10 min (keeps DB small)
      setInterval(() => {
        db.ref("events").limitToFirst(30).once("value").then((snap) => {
          const cutoff = Date.now() - 10 * 60 * 1000;
          snap.forEach((child) => { if (child.val().ts < cutoff) child.ref.remove(); });
        }).catch(() => {});
      }, 60000);

      btn.addEventListener("click", () => {
        paused = !paused;
        btn.textContent = paused ? "Resume Stream" : "Pause Stream";
        btn.style.background = paused ? "var(--green)" : "var(--red)";
      });

      setInterval(tick, 1500);
    });
  </script>
</body>
</html>