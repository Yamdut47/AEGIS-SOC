<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Dashboard</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="dashboard">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>
    <div class="main-area">
      <div id="topbar-slot"></div>

      <div class="content">
        <div class="grid-4">
          <div class="card"><h3>Total Events (24h)</h3><h1 class="blue" id="stat-events">—</h1></div>
          <div class="card"><h3>Active Alerts</h3><h1 class="yellow" id="stat-alerts">—</h1></div>
          <div class="card"><h3>Critical Incidents</h3><h1 class="red" id="stat-incidents">—</h1></div>
          <div class="card"><h3>AI Risk Posture</h3><h1 class="green" id="stat-risk">—</h1></div>
        </div>

        <div class="grid-2" style="height: calc(100vh - 230px)">
          <div class="card">
            <h3 style="color: var(--text-main); font-size: 14px; margin-bottom: 15px">Recent Critical Alerts</h3>
            <table><tbody id="recent-alerts"></tbody></table>
          </div>
          <div class="card">
            <h3 style="color: var(--text-main); font-size: 14px; margin-bottom: 20px">
              AI Threat Distribution <span style="font-size: 10px; color: var(--text-dim)">(live)</span>
            </h3>
            <div id="threat-dist" style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/data.js"></script>
  <script src="js/app.js"></script>

  <script>
    window.addEventListener("aegis-ready", () => {
      const $ = (id) => document.getElementById(id);
      let alerts = [], incidents = [];

      db.ref("stats/totalEvents").on("value", (s) => {
        $("stat-events").textContent = (s.val() || 0).toLocaleString();
      });

      db.ref("incidents").on("value", (s) => {
        incidents = snapshotList(s);
        $("stat-incidents").textContent =
          incidents.filter(i => i.severity === "critical" && i.status !== "resolved").length;
        updateRisk();
      });

      db.ref("alerts").on("value", (s) => {
        alerts = snapshotList(s);
        const open = alerts.filter(a => a.status === "open");
        $("stat-alerts").textContent = open.length;
        $("stat-alerts").className = open.length > 10 ? "red" : "yellow";
        $("recent-alerts").innerHTML = open.slice(0, 5).map(a => `
          <tr>
            <td class="${a.risk > 80 ? "red" : "yellow"}" style="font-family: monospace">${esc(a.source)}</td>
            <td>${esc(a.classification)}</td>
            <td>${badge(a.risk > 80 ? "Critical" : "Medium", a.risk > 80 ? "bg-red" : "bg-purple")}</td>
          </tr>`).join("") || `<tr><td colspan="3" style="color: var(--text-dim)">No open alerts 🎉</td></tr>`;
        renderDistribution(open);
        updateRisk();
      });

      function updateRisk() {
        const open = alerts.filter(a => a.status === "open").length;
        const crit = incidents.filter(i => i.severity === "critical" && i.status !== "resolved").length;
        const score = Math.min(100, 20 + open * 4 + crit * 10);
        const el = $("stat-risk");
        el.textContent = score < 40 ? "Low" : score < 70 ? "Medium" : "Critical";
        el.className = score < 40 ? "green" : score < 70 ? "yellow" : "red";
      }

      const CAT_COLORS = {
        "Brute Force": "var(--yellow)", "SQL Injection": "var(--purple)",
        "Reconnaissance": "var(--accent)", "DDoS": "var(--red)", "Malware": "var(--red)"
      };

      function renderDistribution(list) {
        const counts = {};
        list.forEach(a => { counts[a.category] = (counts[a.category] || 0) + 1; });
        const total = list.length || 1;
        $("threat-dist").innerHTML = Object.entries(counts)
          .sort((a, b) => b[1] - a[1])
          .map(([cat, n]) => {
            const pct = Math.round(n / total * 100);
            const color = CAT_COLORS[cat] || "var(--accent)";
            return `
            <div>
              <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px">
                <span>${esc(cat)}</span><span style="color:${color}">${pct}%</span>
              </div>
              <div style="background:#333;height:10px;border-radius:4px">
                <div style="background:${color};width:${pct}%;height:100%;border-radius:4px"></div>
              </div>
            </div>`;
          }).join("") || `<p style="color:var(--text-dim);font-size:12px">No data</p>`;
      }
    });
  </script>
</body>
</html>