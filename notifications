<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Notifications</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="notifications">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>

    <div class="main-area">
      <div class="topbar">
        <div class="topbar-title" id="page-title"></div>
        <div class="topbar-actions">
          <i class="fas fa-expand" onclick="document.documentElement.requestFullscreen()"></i>
          <i class="fas fa-circle-question"></i>
          <div class="notif-badge"><i class="fas fa-bell"></i></div>
          <div class="avatar" id="user-avatar">A</div>
        </div>
      </div>

      <div class="content">
        <div class="card">
          <div style="border-bottom: 1px solid var(--border); padding: 15px 0; display: flex; justify-content: space-between; align-items: center">
            <div>
              <i class="fas fa-fire red"></i>
              <strong>Critical Incident Escalated</strong>
              <p style="font-size: 12px; color: var(--text-dim); margin-top: 5px">
                INC-2024-08 requires immediate Tier 3 review.
              </p>
            </div>
            <span class="badge bg-red">New</span>
          </div>

          <div style="border-bottom: 1px solid var(--border); padding: 15px 0; display: flex; justify-content: space-between; align-items: center">
            <div>
              <i class="fas fa-check green"></i>
              <strong>SOAR Playbook Executed</strong>
              <p style="font-size: 12px; color: var(--text-dim); margin-top: 5px">
                IP 192.168.1.50 successfully blocked at perimeter.
              </p>
            </div>
            <span class="badge bg-blue">Read</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/app.js"></script>
</body>
</html>