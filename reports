<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Reports</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="reports">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>

    <div class="main-area">
      <div class="topbar">
        <div class="topbar-title" id="page-title"></div>
        <div class="topbar-actions">
          <i class="fas fa-expand" onclick="document.documentElement.requestFullscreen()"></i>
          <i class="fas fa-circle-question"></i>
          <div class="notif-badge"><i class="fas fa-bell"></i></div>
          <div class="avatar" id="user-avatar">A</div>
        </div>
      </div>

      <div class="content">
        <div class="card" style="text-align: center; margin-top: 15vh">
          <i class="fas fa-file-lines" style="font-size: 50px; color: var(--text-dim); margin-bottom: 20px"></i>
          <h3 style="color: var(--text-main); margin-bottom: 10px">Incident Report Generator</h3>
          <p style="margin-bottom: 30px; color: var(--text-dim)">
            Generate comprehensive PDF reports for management or compliance.
          </p>
          <button style="background: var(--accent); color: black; padding: 10px 20px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; margin-right: 10px">
            Executive Summary
          </button>
          <button style="background: var(--bg-dark); color: white; padding: 10px 20px; border: 1px solid var(--border); border-radius: 6px; font-weight: bold; cursor: pointer">
            Technical Deep-Dive
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/app.js"></script>
</body>
</html>