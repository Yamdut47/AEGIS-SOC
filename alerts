<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Alerts</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="alerts">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>

    <div class="main-area">
      <div class="topbar">
        <div class="topbar-title" id="page-title"></div>
        <div class="topbar-actions">
          <i class="fas fa-expand" onclick="document.documentElement.requestFullscreen()"></i>
          <i class="fas fa-circle-question"></i>
          <div class="notif-badge"><i class="fas fa-bell"></i></div>
          <div class="avatar" id="user-avatar">A</div>
        </div>
      </div>

      <div class="content">
        <div class="card">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Time</th>
                <th>Source</th>
                <th>AI Classification</th>
                <th>Risk</th>
                <th>MITRE</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>#1042</td>
                <td>10:45:02</td>
                <td class="red">192.168.1.50</td>
                <td>SSH Brute Force</td>
                <td class="red">94.2%</td>
                <td><span class="badge bg-purple">T1110</span></td>
                <td><span class="badge bg-red">Open</span></td>
              </tr>
              <tr>
                <td>#1041</td>
                <td>10:42:15</td>
                <td class="red">45.33.32.1</td>
                <td>Reconnaissance</td>
                <td class="yellow">45.0%</td>
                <td><span class="badge bg-purple">T1046</span></td>
                <td><span class="badge bg-green">Closed</span></td>
              </tr>
              <tr>
                <td>#1040</td>
                <td>10:38:00</td>
                <td class="red">10.0.0.12</td>
                <td>SQL Injection</td>
                <td class="red">99.1%</td>
                <td><span class="badge bg-purple">T1190</span></td>
                <td><span class="badge bg-red">Open</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/app.js"></script>
</body>
</html>