<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Incidents</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="incidents">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>
    <div class="main-area">
      <div id="topbar-slot"></div>

      <div class="content"><div id="incidents-list"></div></div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/data.js"></script>
  <script src="js/app.js"></script>

  <script>
    window.addEventListener("aegis-ready", () => {
      db.ref("incidents").on("value", (s) => {
        const list = snapshotList(s);
        document.getElementById("incidents-list").innerHTML = list.map(i => {
          const crit = i.severity === "critical";
          const statusBadge = i.status === "resolved" ? badge("Resolved", "bg-green")
            : i.status === "investigating" ? badge("Investigating", "bg-blue")
            : badge("Open", "bg-red");
          return `
          <div class="card" style="border-left: 4px solid var(--${crit ? "red" : "yellow"}); margin-bottom: 15px">
            <div style="display: flex; justify-content: space-between; align-items: flex-start">
              <div>
                <h3 style="color: var(--text-main); font-size: 16px; margin-bottom: 5px">${esc(i.title)}</h3>
                <p style="font-size: 13px; color: var(--text-dim)">${esc(i.desc)}</p>
              </div>
              <div style="text-align: right">
                ${badge(crit ? "Critical" : "High", crit ? "bg-red" : "bg-yellow")}
                <span style="margin-left: 5px">${statusBadge}</span>
                ${i.status !== "resolved" ? `<br><button onclick="resolveIncident('${i.id}')" style="margin-top: 10px; background: var(--green); color: black; border: none; padding: 5px 12px; border-radius: 4px; cursor: pointer; font-size: 11px; font-weight: bold">Resolve</button>` : ""}
              </div>
            </div>
          </div>`;
        }).join("") || `<div class="card"><p style="color: var(--text-dim)">No incidents.</p></div>`;
      });
    });

    function resolveIncident(id) {
      db.ref("incidents/" + id + "/status").set("resolved");
    }
  </script>
</body>
</html>