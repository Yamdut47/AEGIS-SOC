<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Logs</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="logs">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>
    <div class="main-area">
      <div id="topbar-slot"></div>

      <div class="content">
        <div class="card">
          <div style="display: flex; gap: 10px; margin-bottom: 15px">
            <input type="text" id="log-search" placeholder="Search by IP, Payload..." style="flex: 1; padding: 8px; background: var(--bg-dark); border: 1px solid var(--border); color: white; border-radius: 4px" />
            <select id="log-proto" style="padding: 8px; background: var(--bg-dark); border: 1px solid var(--border); color: white; border-radius: 4px">
              <option value="All">All Protocols</option>
              <option value="TCP">TCP</option>
              <option value="UDP">UDP</option>
            </select>
          </div>
          <table>
            <thead>
              <tr>
                <th>Timestamp</th><th>Source IP</th><th>Dest IP</th><th>Proto</th><th>Port</th><th>Payload Snippet</th>
              </tr>
            </thead>
            <tbody id="logs-tbody">
              <tr><td colspan="6" style="color: var(--text-dim)">Loading events from database...</td></tr>
              <tr id="logs-empty" style="display: none"><td colspan="6" style="color: var(--text-dim)">No matching logs. (Tip: open Live Monitoring to generate events)</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/data.js"></script>
  <script src="js/app.js"></script>

  <script>
    window.addEventListener("aegis-ready", () => {
      let all = [];
      const tbody = document.getElementById("logs-tbody");
      const search = document.getElementById("log-search");
      const protoSel = document.getElementById("log-proto");
      const empty = document.getElementById("logs-empty");

      function render() {
        const q = search.value.trim().toLowerCase();
        const proto = protoSel.value;
        const rows = all.filter(e =>
          (proto === "All" || e.proto === proto) &&
          (!q || ((e.src || "") + " " + (e.dst || "") + " " + (e.payload || "")).toLowerCase().includes(q))
        );
        const html = rows.map(e => {
          const srcClass = e.level === "CRIT" ? "red" : (e.level === "WARN" || e.level === "ALERT") ? "yellow" : "";
          return `<tr>
            <td>${fmtTime(e.ts)}</td>
            <td class="${srcClass}">${esc(e.src)}</td>
            <td>${esc(e.dst)}</td>
            <td>${esc(e.proto)}</td>
            <td>${e.port}</td>
            <td style="font-family: monospace; font-size: 11px; color: var(--text-dim)">${esc(e.payload)}</td>
          </tr>`;
        }).join("");
        tbody.innerHTML = html + (rows.length ? "" : "");
        empty.style.display = rows.length ? "none" : "table-row";
      }

      db.ref("events").limitToLast(100).on("value", (s) => {
        all = snapshotList(s);
        render();
      });

      search.addEventListener("input", render);
      protoSel.addEventListener("change", render);
    });
  </script>
</body>
</html>