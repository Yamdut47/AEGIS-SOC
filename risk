<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aegis-SOC | Risk Analysis</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="risk">
  <div class="page-loader" id="page-loader"><i class="fas fa-shield-halved fa-spin"></i></div>

  <div class="app-container" id="app">
    <div id="sidebar-slot"></div>

    <div class="main-area">
      <div class="topbar">
        <div class="topbar-title" id="page-title"></div>
        <div class="topbar-actions">
          <i class="fas fa-expand" onclick="document.documentElement.requestFullscreen()"></i>
          <i class="fas fa-circle-question"></i>
          <div class="notif-badge"><i class="fas fa-bell"></i></div>
          <div class="avatar" id="user-avatar">A</div>
        </div>
      </div>

      <div class="content">
        <div class="grid-2" style="height: calc(100vh - 150px)">
          <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2px solid var(--red)">
            <h3 style="margin: 0 0 10px 0; color: var(--text-dim)">Current Organizational Risk Posture</h3>
            <h1 class="red" style="font-size: 80px">87</h1>
            <span class="badge bg-red" style="font-size: 14px; padding: 5px 10px">CRITICAL RISK</span>
          </div>

          <div class="card">
            <h3 style="color: var(--text-main); margin-bottom: 20px">Risk Factors Breakdown</h3>
            <table>
              <tr><td>Unpatched Assets</td><td class="red">High (25pts)</td></tr>
              <tr><td>Exposed RDP Ports</td><td class="red">Critical (35pts)</td></tr>
              <tr><td>Active Brute Forces</td><td class="yellow">Medium (15pts)</td></tr>
              <tr><td>Malware Signatures</td><td class="green">Low (2pts)</td></tr>
              <tr><td>Data Loss Prevention</td><td class="yellow">Medium (10pts)</td></tr>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/app.js"></script>
</body>
</html>